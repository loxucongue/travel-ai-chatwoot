APP_ENV=development
APP_PROFILE=evaluation
OUTBOUND_MODE=disabled
CHATWOOT_WRITE_ENABLED=false
LIVE_REPLY_ACCOUNT_ID=180474
LIVE_REPLY_INBOX_ID=128859
LIVE_SOP_ENABLED=false
# allowlist = only LIVE_SOP_CONVERSATION_IDS can receive real SOP sends.
# ai_label = every Chatwoot conversation with the remote "ai" label can receive real SOP sends.
LIVE_SOP_SCOPE=allowlist
LIVE_SOP_CONVERSATION_IDS=
PUBLIC_API_BASE_URL=https://api.luoxuecong.asia
APP_SECRET_KEY=replace-with-random-secret
APP_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./data/app.db
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4175
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
CHATWOOT_REQUEST_TIMEOUT_SECONDS=15
AI_REQUEST_TIMEOUT_SECONDS=15
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional fallback; legacy GEMINI_* names remain for deployment compatibility.
# For Bailian: provider=bailian, URL=https://dashscope.aliyuncs.com/compatible-mode/v1,
# model=deepseek-v4.1-flash, and GEMINI_API_KEY is the Bailian key.
GEMINI_FALLBACK_ENABLED=false
MODEL_FALLBACK_PROVIDER=gemini
# Bailian only: disable thinking for a faster emergency fallback. Primary is unchanged.
MODEL_FALLBACK_THINKING_ENABLED=true
GOOGLE_GEMINI_BASE_URL=https://linkai.shop
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
# Reserve time for fallback inside the existing per-call deadline.
MODEL_PRIMARY_PROBE_SECONDS=20
# Zero means each new turn starts with primary; a tool turn may stay on fallback.
MODEL_PRIMARY_COOLDOWN_SECONDS=0
MODEL_FALLBACK_COOLDOWN_SECONDS=300
# Optional semantic repetition review of free-text replies (one small model call).
# Enable after conversation acceptance; false retains the primary reply.
RECEPTION_REPEAT_REVIEW_ENABLED=false
DEEPSEEK_VISION_MODEL=deepseek-flash
CUSTOMER_IMAGE_VISION_ENABLED=false
# Verified sticker fingerprints; enable only after acceptance. No vision API call.
CUSTOMER_STICKER_RECOGNITION_ENABLED=false
CUSTOMER_IMAGE_ALLOWED_HOSTS=app.chatwoot.com
CUSTOMER_IMAGE_STORAGE_HOSTS=prod-chatwoot-assets.s3.amazonaws.com
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_INPUT_CHARACTERS=300000
EVALUATION_POLL_INTERVAL_SECONDS=1
EVALUATION_INBOX_ID=128859
BUSINESS_MATERIALS_DIR=E:\\AI\\codexproject\\ai_chatwoot\\給ai
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
RELAY_BASE_URL=https://relay.luoxuecong.asia
RELAY_API_TOKEN=
RELAY_POLL_INTERVAL_SECONDS=1
RELAY_POLL_BATCH_SIZE=10
RELAY_REQUEST_TIMEOUT_SECONDS=15
RELAY_CLEANUP_INTERVAL_SECONDS=21600
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO
