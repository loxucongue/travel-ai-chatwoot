[Unit]
Description=Rujing2 AI API
After=network.target

[Service]
User=rujing2
Group=rujing2
WorkingDirectory=/opt/rujing2-ai/current/backend
EnvironmentFile=/opt/rujing2-ai/shared/backend.env
ExecStart=/opt/rujing2-ai/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8012 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/rujing2-ai/shared

[Install]
WantedBy=multi-user.target
