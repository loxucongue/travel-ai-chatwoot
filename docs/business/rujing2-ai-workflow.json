    {"from": "reply", "to": "delivery", "label": "能够回答", "role": "main"},
    {"from": "permission", "to": "manual", "label": "未开启 / 已人工接管", "role": "branch", "variant": "security"},
    {"from": "reply", "to": "handoff", "label": "需核实 / 要真人 / 已留资", "role": "branch", "variant": "security"}
  ],
  "cards": [
    {"dot": "cyan", "title": "素材按问题使用", "items": ["问住宿发已确认酒店资料，问行程发对应线路。", "价格由系统按已审规则计算；AI 不自行换汇或编价。"]},
    {"dot": "amber", "title": "先测试，再开放", "items": ["此图说明配置完成后的流程，不代表已开放自动接待。", "人工接管后 AI 暂停；恢复接待需重新满足启用条件。"]}
