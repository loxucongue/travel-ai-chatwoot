{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rujing2-chatwoot-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rujing2-chatwoot-relay",
      "database_id": "REPLACE_WITH_NEW_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "routes": []
}
